# Nested reference repository; keep it outside this project's history.
/PCL/

# Node / Vite
node_modules/
dist/
.vite/
playwright-report/
test-results/

# Rust
/target/
**/target/

# Desktop installers collected by hand from target/release/bundle/ for testing.
# They are build output, not source: anyone can regenerate them.
/dist-artifacts/

# Tauri build artifacts
src-tauri/gen/
src-tauri/target/

# Locally staged aria2 binaries and provenance: produced by scripts/aria2/
# after a reviewed build, pinned locally via distribute.py stage. Not
# distributed from this repository until the license review completes.
src-tauri/resources/aria2/*
!src-tauri/resources/aria2/.gitkeep

# Local app data and credentials
.env
.env.*
!.env.example
*.log
*.sqlite
*.sqlite3
*.db
# Crash-analysis fixtures are source: the rules ship with them as regression
# tests, and `crash-ai-cli --self-test` include_str!s them at compile time.
# Without this exception they are silently dropped by the `*.log` rule above,
# which made `cargo build --workspace` fail on a clean clone.
!crates/crash-ai/src/fixtures/*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.audit/

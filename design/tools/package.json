{
  "name": "mfmcl-design-validation",
  "private": true,
  "version": "1.0.0",
  "description": "Schema validation and local rendering for editable Sketch design deliverables",
  "scripts": {
    "build": "python3 generate_design.py",
    "validate": "node validate.cjs",
    "scan:width": "node ui-width-scan.cjs",
    "scan:depth": "node ui-depth-scan.cjs",
    "test:plugins": "node plugin-install-regression.cjs",
    "test:distribution": "node aria-assets-regression.cjs",
    "test:distribution:fixtures": "node aria-assets-regression.cjs --fixtures-only",
    "test:aria-assets": "node aria-assets-regression.cjs"
  },
  "devDependencies": {
    "@sketch-hq/sketch-file-format": "6.5.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "1.64.1"
  }
}

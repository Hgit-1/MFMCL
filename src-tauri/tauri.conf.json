{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MFMCL",
  "version": "0.1.0",
  "identifier": "dev.mfmcl.launcher",
  "build": {
    "beforeDevCommand": "npm run dev --prefix design/flowlaunch-ui -- --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build --prefix design/flowlaunch-ui",
    "frontendDist": "../design/flowlaunch-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MFMCL",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.modrinth.com https://api.curseforge.com https://launchermeta.mojang.com https://piston-meta.mojang.com;"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/aria2-manifest.json": "resources/aria2-manifest.json",
      "resources/aria2/": "aria2/"
    },
    "shortDescription": "Minecraft Java Edition launcher",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
